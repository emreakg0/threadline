# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

.git
.cache
.config
.conversation
.local
**/.local
.aws
.ssh
.envrc
**/.envrc*
.env
.env.*
**/.env
**/.env.*
**/threadline-gemini-authorization.json
**/client_secret*.json
**/client-secret*.json
**/*credentials*.json
**/*oauth*.json
**/token*.json
**/*-token.json
**/service-account*.json
**/service_account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.git-credentials
**/.netrc
**/.npmrc.local
data
backups
attached_assets
**/*.dump
**/*.backup
**/*.sqlite*
**/*.db
**/*.sql.gz
**/*.log
