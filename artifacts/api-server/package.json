{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../lib/db/scripts/migrate.mjs && tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "THREADLINE_PRODUCTION_AI_APPROVED=false THREADLINE_GEMINI_LIVE_AUTHORIZED=false pnpm run test:offline",
    "test:authorization": "tsx src/extraction/authorization.test.ts",
    "test:action-thread": "tsx --test src/action-thread/graph.test.ts",
    "test:action-thread:integration": "tsx src/action-thread/integration.test.ts",
    "test:offline": "pnpm run test:authorization && pnpm run test:action-thread && pnpm run test:action-thread:integration && tsx src/focus.integration.ts && tsx src/documents.integration.ts && tsx src/extraction/extraction.test.ts && node --import tsx src/extraction/durable.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "express": "^5.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "@workspace/db": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
